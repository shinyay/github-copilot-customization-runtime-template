<%@ include file="../fragments/tags.jspf" %>
<%@ include file="../fragments/header.jspf" %>
<section class="card"><h2><c:out value="${receipt.number}"/></h2><dl><dt>仕入発注</dt><dd><a href="<c:out value='${ctx}'/>/purchases.do?op=detail&amp;id=<c:out value='${receipt.order.id}'/>"><c:out value="${receipt.order.number}"/></a></dd><dt>入荷日 / 納品番号</dt><dd><fmt:formatDate value="${receipt.receiptDate}" pattern="yyyy-MM-dd"/> / <c:out value="${receipt.supplierDeliveryNumber}"/></dd><dt>受領者 / 日時</dt><dd><c:out value="${receipt.receivedBy}"/> / <fmt:formatDate value="${receipt.receivedAt}" pattern="yyyy-MM-dd HH:mm"/></dd><dt>良品金額</dt><dd><fmt:formatNumber value="${receipt.acceptedAmount}" pattern="#,##0.00"/> 円</dd><dt>備考</dt><dd><c:out value="${receipt.notes}"/></dd><dt>受付キー</dt><dd class="mono"><c:out value="${receipt.requestKey}"/></dd></dl></section>
<section class="card"><h2>検品明細</h2><div class="table-wrap"><table><thead><tr><th>商品</th><th class="number">良品 / 不良</th><th>不良理由</th><th class="number">良品金額</th><th>在庫入庫伝票</th></tr></thead><tbody>
  <c:forEach items="${receipt.lines}" var="line"><tr><td><c:out value="${line.orderLine.productCode}"/> <c:out value="${line.orderLine.productName}"/></td><td class="number"><c:out value="${line.acceptedQuantity}"/> / <c:out value="${line.rejectedQuantity}"/></td><td><c:out value="${line.rejectionReason}"/><br><c:out value="${line.notes}"/></td><td class="number"><fmt:formatNumber value="${line.acceptedAmount}" pattern="#,##0.00"/></td><td><c:if test="${not empty line.stockReceipt}"><a href="<c:out value='${ctx}'/>/receipts.do?op=detail&amp;id=<c:out value='${line.stockReceipt.id}'/>"><c:out value="${line.stockReceipt.number}"/></a></c:if></td></tr></c:forEach>
</tbody></table></div></section>
<%@ include file="../fragments/footer.jspf" %>

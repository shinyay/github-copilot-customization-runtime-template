<%@ page pageEncoding="UTF-8" %>
<section class="card"><h2>保存済み第<c:out value="${quoteRevision.revisionNumber}"/>版 · <c:out value="${quoteRevision.customerName}"/></h2>
  <div class="grid"><dl><dt>顧客名（版の写し）</dt><dd><c:out value="${quoteRevision.customerName}"/></dd><dt>倉庫（現在の名称）</dt><dd><c:out value="${quoteRevision.warehouse.name}"/></dd><dt>見積日 / 有効期限</dt><dd><fmt:formatDate value="${quoteRevision.quoteDate}" pattern="yyyy-MM-dd"/> / <fmt:formatDate value="${quoteRevision.validUntil}" pattern="yyyy-MM-dd"/></dd><dt>提案納期</dt><dd><fmt:formatDate value="${quoteRevision.requestedDate}" pattern="yyyy-MM-dd"/></dd><dt>納入先（版の写し）</dt><dd><c:out value="${quoteRevision.deliveryAddress}"/></dd><dt>客先参照番号</dt><dd><c:out value="${quoteRevision.externalReference}"/></dd></dl>
    <dl><dt>税抜 / 消費税</dt><dd class="number"><fmt:formatNumber value="${quoteRevision.netAmount}" pattern="#,##0.00"/> / <fmt:formatNumber value="${quoteRevision.taxAmount}" pattern="#,##0.00"/></dd><dt>税込合計</dt><dd class="number"><strong><fmt:formatNumber value="${quoteRevision.totalAmount}" pattern="#,##0.00"/> 円</strong></dd><dt>税端数処理</dt><dd><c:out value="${quoteRevision.taxRounding}"/></dd><dt>版作成者 / 日時</dt><dd><c:out value="${quoteRevision.authoredBy}"/> / <fmt:formatDate value="${quoteRevision.authoredAt}" pattern="yyyy-MM-dd HH:mm"/></dd><dt>版作成・改訂理由</dt><dd><c:out value="${quoteRevision.changeReason}"/></dd><dt>備考</dt><dd class="prewrap"><c:out value="${quoteRevision.notes}"/></dd></dl></div>
</section>
<section class="card"><h2>保存済みの価格・税率・明細</h2>
  <div class="table-wrap"><table><thead><tr><th>商品・品名（版の写し）</th><th class="number">数量 / 入数</th><th class="number">当時の価格条件単価</th><th class="number">提案単価</th><th>交渉理由 / 税率</th><th class="number">税抜金額</th></tr></thead><tbody>
    <c:forEach items="${quoteRevision.lines}" var="line"><tr><td><c:out value="${line.productCode}"/> <c:out value="${line.productName}"/></td><td class="number"><c:out value="${line.quantity}"/> <c:out value="${line.unit}"/> / <c:out value="${line.packSize}"/></td><td class="number"><fmt:formatNumber value="${line.catalogUnitPrice}" pattern="#,##0.00"/></td><td class="number"><fmt:formatNumber value="${line.unitPrice}" pattern="#,##0.00"/><c:if test="${line.negotiated}"><br><span class="badge">交渉提案</span></c:if></td><td><c:out value="${line.negotiationReason}"/><br><fmt:formatNumber value="${line.taxRate}" type="percent"/></td><td class="number"><fmt:formatNumber value="${line.netAmount}" pattern="#,##0.00"/></td></tr></c:forEach>
  </tbody></table></div>
  <p class="help">この版の明細は履歴として保持されます。整合性ハッシュは内部検査用であり、顧客の電子署名ではありません。</p><p class="mono"><c:out value="${quoteRevision.fingerprint}"/></p>
</section>

<%@ page pageEncoding="UTF-8" %>
<form method="get" action="<c:out value='${ctx}${route}'/>" class="toolbar" role="search">
  <input type="hidden" name="op" value="<c:out value='${form.op}'/>">
  <label>仕入先<select name="supplierId"><option value="">すべて</option><c:forEach items="${suppliers}" var="supplier"><option value="<c:out value='${supplier.id}'/>" <c:if test="${form.supplierId eq fn:escapeXml(supplier.id)}">selected</c:if>><c:out value="${supplier.code}"/> <c:out value="${supplier.name}"/></option></c:forEach></select></label>
  <label>キーワード<input type="search" name="text" maxlength="100" value="<c:out value='${form.text}'/>"></label>
  <c:if test="${not empty statuses}"><label>状態<select name="status"><option value="">すべて</option><c:forEach items="${statuses}" var="s"><option value="<c:out value='${s}'/>" <c:if test="${form.status eq s}">selected</c:if>><c:out value="${s}"/></option></c:forEach></select></label></c:if>
  <label>開始日<input type="date" name="from" value="<c:out value='${form.from}'/>"></label>
  <label>終了日<input type="date" name="to" value="<c:out value='${form.to}'/>"></label>
  <c:if test="${reportMode eq 'open'}"><label>残高基準日<input type="date" name="asOf" value="<c:out value='${form.asOf}'/>"></label><label>期限超過<select name="overdueOnly"><option value="false">すべて</option><option value="true" <c:if test="${form.overdueOnly eq 'true'}">selected</c:if>>超過分のみ</option></select></label></c:if>
  <label>表示件数<select name="size"><c:forTokens items="10,25,50,100" delims="," var="n"><option value="<c:out value='${n}'/>" <c:if test="${form.size eq n}">selected</c:if>><c:out value="${n}"/>件</option></c:forTokens></select></label>
  <button class="primary">照会</button>
</form>

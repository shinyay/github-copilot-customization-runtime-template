<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN" "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="jp.co.tsubame.wholesale.batch.entity" default-lazy="false">
  <class name="OrderImportRecord" table="batch_order_import" mutable="false">
    <id name="id"><generator class="sequence"><param name="sequence">wholesale_seq</param></generator></id>
    <version name="version"/>
    <property name="externalKey" column="external_key" length="120" unique="true" not-null="true"/>
    <property name="payloadHash" column="payload_hash" length="64" not-null="true"/>
    <many-to-one name="order" class="jp.co.tsubame.wholesale.entity.SalesOrder" column="order_id" unique="true" not-null="true"/>
    <property name="createdById" column="created_by_id" not-null="true"/>
    <property name="createdBy" column="created_by" length="50" not-null="true"/>
    <property name="createdAt" column="created_at" type="timestamp" not-null="true"/>
  </class>
</hibernate-mapping>
